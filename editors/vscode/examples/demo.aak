# AdarshLang demo: exercises every highlighted construct.
# Open this file to eyeball the grammar.

# ---- literals and declarations
badlo x = 5;
badlo pi = 3.14;
badlo half = .5;
badlo big = 1e5;
badlo small = 2.5e-3;
badlo million = 1_000_000;
badlo ok = sahi_hai_be;
badlo no = jhuth;
badlo nothing = khali;
badlo items = [1, 2, 3];

# ---- strings, escapes and interpolation
badlo msg = "Namaste\n\tduniya \"ji\" \\ \0 \{ literal \} ok";
dikhao("x ka value: { x }, double: { x * 2 }");
dikhao("nested: { upper("hi") }");

# ---- operators
badlo sum = x + 2 - 1 * 3 / 4 % 2 ** 2;
x += 1;
x -= 1;
x *= 2;
x /= 2;
x %= 3;
agar (x >= 1 aur x <= 10 ya nahin (x == 5)) {
    dikhao("range");
}
agar (x != 0 && x < 3 || !jhuth) {
    dikhao("logic");
}

# ---- control flow
agar (x > 3) {
    dikhao("bada");
} warna agar (x == 3) {
    dikhao("barabar");
} warna {
    dikhao("chota");
}

jabtak (x > 0) {
    x -= 1;
    agar (x == 2) { aage_badho; }
    agar (x == 1) { bas; }
}

ginnati (badlo i = 0; i < 10; i += 1) {
    dikhao(i);
}

ke_liye (badlo v in items) {
    dikhao(v);
}

chuno (x) {
    case 1, 2:
        dikhao("a");
    warna_case: {
        dikhao("baaki");
    }
}

# ---- functions and methods
kaam naam(a, b = 2, baaki rest) {
    wapas a + b;
}

kaam helper(n) {
    wapas naam(n);
}

# ---- records
dhacha Vyakti { naam, umar };

kaam Vyakti.naam_dikhao() {
    wapas yeh.naam;
}

badlo v1 = Vyakti { naam: "Adarsh", umar: 20 };
v1.naam_dikhao();

# ---- builtins
badlo nums = range(1, 10);
badlo doubled = map(kaam (n) { wapas n * 2; }, nums);
badlo evens = filter(kaam (n) { wapas n % 2 == 0; }, nums);
badlo total = reduce(kaam (acc, n) { wapas acc + n; }, nums, 0);
push(nums, 11);
pop(nums);
badlo marks = {"math": 90};
rakho(marks, "hindi", 85);
nikalo(marks, "science", 0);
hatao(marks, "math");
badlo n = length(nums);
badlo r = random_number(1, 6);
badlo t = current_time();
abs(-3);
floor(2.7);
ceil(2.1);
round_val(2.5);
upper("abc");
lower("ABC");
trim("  x  ");
replace("aaa", "a", "b");
join(["a", "b"], ",");
split("a,b", ",");
prakar(1);
shabdme(1);
sankhya("5");
keys(v1);
values(v1);
contains(nums, 3);
sort(nums);
reverse(nums);
slice(nums, 0, 2);
find(nums, 3);
min_val(3, 7);
max_val(3, 7);
badlo jawab = padho("Naam batao: ");
# lao "utils.aak";   imports another file

# ---- error handling
pakdo {
    chhoddo("kuch galat");
} chhoddo (err) {
    dikhao(err);
}

# ============================================================
# Language 0.3 additions
# ============================================================

# ---- pakka (constant) and vikalp (enum)
pakka PI_ISH = 3.14;
vikalp Rang { Laal, Hara };
badlo pasand = Rang.Laal;
dikhao(pasand);

# ---- karo ... jabtak (do-while): body kam se kam ek baar chalti hai
badlo tries = 0;
karo {
    tries += 1;
} jabtak (tries < 3);
dikhao(tries);

# ---- type annotations, hai (type check), -> return type
badlo umar: number = 20;
dikhao(umar hai number);
kaam bataao(x: number) -> string {
    wapas "number hai: { x }";
}
dikhao(bataao(umar));

# ---- labels: bahar: jabtak / ginnati / ke_liye / karo, bas bahar; aage_badho bahar;
badlo bahar_count = 0;
bahar: ginnati (badlo a = 0; a < 3; a += 1) {
    ginnati (badlo b = 0; b < 3; b += 1) {
        agar (b == 1) { aage_badho bahar; }
        bahar_count += 1;
    }
}
dikhao(bahar_count);

badlo tala = 0;
ruk: jabtak (sahi_hai_be) {
    tala += 1;
    agar (tala == 4) { bas ruk; }
}
dikhao(tala);

# ---- operators: .. (range), ... (spread), ?. (safe access), ?? (default),
#      // (integer division), => (lambda)
dikhao(1..4);
badlo ekdam = [0, ...items];
dikhao(ekdam);
dikhao(7 // 2);
badlo koi_v = khali;
dikhao(koi_v?.naam ?? "naam nahi mila");
badlo sq = (x) => x * x;
dikhao(sq(4));

# ---- raw strings r"..." and r"""...""" (no escapes, no {} interpolation)
badlo raw_path = r"C:\naya\{folder}";
dikhao(raw_path);
badlo raw_block = r"""pehli line \n
doosri line {x}""";
dikhao(raw_block);

# ---- triple-quoted string: escapes and {expr} interpolation work, multiline
badlo likhawat = """pehli line
doosri line: { umar + 1 }\tend""";
dikhao(likhawat);

# ---- interpolation with format spec: {x:.2}, {daam:>8}
badlo daam = 12.5;
dikhao("[{daam:>8}] [{daam:.2}]");

# ---- comments: #[ block ]# and ## doc comment (// is NOT a comment)
#[ Yeh block comment hai.
   Kai lines tak chal sakta hai. ]#
## Doc comment: neeche wala function ek jod deta hai.
kaam jod(a, b) {
    wapas a + b;
}

# ---- dete_raho (yield): function ke saare yield kiye values list mein milte hain
kaam ginti_do() {
    dete_raho 1;
    dete_raho 2;
}
dikhao(ginti_do());

# ---- inheritance and typed catch / aakhir (finally)
dhacha Student : Vyakti { roll, umar = 0 };
badlo st = Student { naam: "Riya", roll: 7 };
dikhao(st.roll);

pakdo {
    badlo bhaag = 1 / 0;
} chhoddo (e: Galti) {
    dikhao("galti pakdi");
} aakhir {
    dikhao("aakhir wala block");
}

# ---- lao ... as (module alias)
lao "ganit" as g;
dikhao(g.dugna(4));

# ---- constants and Devanagari keywords
dikhao(PI_ISH);
बदलो संख्या = 7;
अगर (संख्या है number) { दिखाओ("देवनागरी ठीक है"); } वरना { दिखाओ("गड़बड़"); }

# kachhua (turtle) ke methods: kachhua.aage(100), kachhua.daayen(90), kachhua.kalam_upar()
# Yahan drawing nahi chalayi kyunki woh .svg file likhti hai. Snippet "kachhua" se square banao.
