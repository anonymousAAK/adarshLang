{
  "if": {
    "prefix": "agar",
    "body": [
      "agar (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "agar (if) block"
  },
  "if-else": {
    "prefix": "agarwarna",
    "body": [
      "agar (${1:condition}) {",
      "\t$2",
      "} warna {",
      "\t$0",
      "}"
    ],
    "description": "agar ... warna (if / else) block"
  },
  "while": {
    "prefix": "jabtak",
    "body": [
      "jabtak (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "jabtak (while) loop"
  },
  "for": {
    "prefix": "ginnati",
    "body": [
      "ginnati (badlo ${1:i} = 0; $1 < ${2:n}; $1 += 1) {",
      "\t$0",
      "}"
    ],
    "description": "ginnati (counting for) loop"
  },
  "for-in": {
    "prefix": "keliye",
    "body": [
      "ke_liye (badlo ${1:v} in ${2:items}) {",
      "\t$0",
      "}"
    ],
    "description": "ke_liye (for-each) loop"
  },
  "switch": {
    "prefix": "chuno",
    "body": [
      "chuno (${1:x}) {",
      "\tcase ${2:1}:",
      "\t\t$0",
      "\twarna_case: {",
      "\t}",
      "}"
    ],
    "description": "chuno (switch) with case and warna_case"
  },
  "function": {
    "prefix": "kaam",
    "body": [
      "kaam ${1:naam}(${2:a}) {",
      "\twapas $0;",
      "}"
    ],
    "description": "kaam (function) definition"
  },
  "record": {
    "prefix": "dhacha",
    "body": [
      "dhacha ${1:Vyakti} { ${2:naam, umar} };"
    ],
    "description": "dhacha (record / struct) declaration"
  },
  "try-catch": {
    "prefix": "pakdo",
    "body": [
      "pakdo {",
      "\t$1",
      "} chhoddo (${2:err}) {",
      "\t$0",
      "}"
    ],
    "description": "pakdo ... chhoddo (try / catch) block"
  },
  "try-catch-finally": {
    "prefix": "pakdoaakhir",
    "body": [
      "pakdo {",
      "\t$1",
      "} chhoddo (${2:err}) {",
      "\t$3",
      "} aakhir {",
      "\t$0",
      "}"
    ],
    "description": "pakdo ... chhoddo ... aakhir (try / catch / finally) block"
  },
  "do-while": {
    "prefix": "karo",
    "body": [
      "karo {",
      "\t$0",
      "} jabtak (${1:condition});"
    ],
    "description": "karo ... jabtak (do-while loop, body runs at least once)"
  },
  "enum": {
    "prefix": "vikalp",
    "body": [
      "vikalp ${1:Rang} { ${2:Laal}, ${3:Hara} };"
    ],
    "description": "vikalp (enum) declaration"
  },
  "lambda": {
    "prefix": "lambda",
    "body": [
      "(${1:x}) => ${2:x * 2}"
    ],
    "description": "lambda (arrow function)"
  },
  "test": {
    "prefix": "test",
    "body": [
      "kaam test_${1:naam}() {",
      "\tjaancho(${2:sharat}, \"${3:sandesh}\");",
      "}"
    ],
    "description": "test function that checks a condition with jaancho"
  },
  "kachhua-square": {
    "prefix": "kachhua",
    "body": [
      "ginnati (badlo ${1:i} = 0; $1 < 4; $1 += 1) {",
      "\tkachhua.aage(100);",
      "\tkachhua.daayen(90);",
      "}"
    ],
    "description": "kachhua (turtle) draws a square: 4 times aage(100) and daayen(90)"
  }
}
