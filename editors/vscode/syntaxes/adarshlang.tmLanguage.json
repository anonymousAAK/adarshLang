{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AdarshLang",
  "scopeName": "source.adarshlang",
  "fileTypes": ["aak"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#record-construction" },
    { "include": "#control-keywords" },
    { "include": "#storage-keywords" },
    { "include": "#logical-operators" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#this" },
    { "include": "#builtins" },
    { "include": "#function-calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.adarshlang",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.adarshlang",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.adarshlang",
          "match": "\\\\[ntr\\\\\"0{}]"
        },
        {
          "name": "meta.interpolation.adarshlang",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.adarshlang" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.adarshlang" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.adarshlang",
          "match": "(?<![\\w.])(?:\\d[\\d_]*(?:\\.[\\d_]+)?|\\.\\d[\\d_]*)(?:[eE][+-]?\\d[\\d_]*)?(?!\\w)"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "kaam Type.method(",
          "match": "\\b(kaam)\\s+([A-Za-z_]\\w*)\\.([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.adarshlang" },
            "2": { "name": "entity.name.type.adarshlang" },
            "3": { "name": "entity.name.function.adarshlang" }
          }
        },
        {
          "comment": "kaam name(",
          "match": "\\b(kaam)\\s+([A-Za-z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "storage.type.adarshlang" },
            "2": { "name": "entity.name.function.adarshlang" }
          }
        },
        {
          "comment": "dhacha Name",
          "match": "\\b(dhacha)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.adarshlang" },
            "2": { "name": "entity.name.type.adarshlang" }
          }
        }
      ]
    },
    "record-construction": {
      "patterns": [
        {
          "comment": "Name { ... } where Name starts uppercase",
          "name": "entity.name.type.adarshlang",
          "match": "\\b([A-Z]\\w*)(?=\\s*\\{)"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.adarshlang",
          "match": "\\b(?:agar|warna_case|warna|jabtak|ginnati|ke_liye|in|chuno|case|bas|aage_badho|wapas|pakdo|chhoddo|lao)\\b"
        }
      ]
    },
    "storage-keywords": {
      "patterns": [
        {
          "name": "storage.type.adarshlang",
          "match": "\\b(?:badlo|kaam|dhacha|baaki)\\b"
        }
      ]
    },
    "logical-operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.adarshlang",
          "match": "\\b(?:aur|ya|nahin)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.adarshlang",
          "match": "&&|\\|\\||\\*\\*|==|!=|<=|>=|\\+=|-=|\\*=|/=|%=|[<>+\\-*/%=!]"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.adarshlang",
          "match": "\\b(?:sahi_hai_be|jhuth|khali)\\b"
        }
      ]
    },
    "this": {
      "patterns": [
        {
          "name": "variable.language.this.adarshlang",
          "match": "\\byeh\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.adarshlang",
          "match": "\\b(?:dikhao|length|push|pop|rakho|nikalo|hatao|map|filter|reduce|random_number|current_time|abs|floor|ceil|upper|lower|join|split|prakar|shabdme|sankhya|range|keys|values|contains|sort|reverse|slice|replace|trim|find|min_val|max_val|round_val|padho)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.adarshlang",
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=\\()"
        }
      ]
    }
  }
}
