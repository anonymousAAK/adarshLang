badlo collected = [];

ginnati (badlo i = 0; i < 10; i = i + 1) {
    agar (i == 3) {
        aage_badho;
    }
    push(collected, i);
badlo counter = 0;
badlo collected = [];

jabtak (counter < 10) {
    counter = counter + 1;
    agar (counter == 3) {
        aage_badho;
    }
    push(collected, counter);
    agar (length(collected) == 4) {
        bas;
    }
}

badlo fruits = ["seb", "kela", "amrud"];
ke_liye (badlo fruit : fruits) {
    push(collected, length(fruit));
}

badlo mood = "khush";
chuno (mood) {
    case "udaas":
        push(collected, -1);
    case "khush":
        push(collected, 42);
    warna_case:
        push(collected, 0);
}

dikhao("Collected values:");
dikhao(collected);
