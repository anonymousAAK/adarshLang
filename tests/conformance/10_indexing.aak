# Indexing lists and strings, including negative indices, whole-number float indices,
# and index assignment.

badlo xs = [10, 20, 30, 40];
dikhao(xs[0]);
dikhao(xs[-1]);
dikhao(xs[-4]);
dikhao(xs[1 + 1]);
dikhao(xs[4 / 2]);

badlo idx = 1;
dikhao(xs[idx]);
dikhao(nikalo(xs, -1));

xs[-2] = 99;
dikhao(xs);
xs[0] = xs[-1] + 1;
dikhao(xs);

badlo s = "Adarsh";
dikhao(s[0]);
dikhao(s[-1]);
dikhao(s[-6]);
dikhao(s[1] + s[-3]);

# nested indexing and assignment
badlo m = [[1, 2], [3, 4]];
dikhao(m[1][0]);
m[0][1] = 7;
dikhao(m);
m[-1][-1] = m[0][1] * 2;
dikhao(m);

# index into a dict built from a list of pairs
badlo table = {"first": xs[0], "last": xs[-1]};
dikhao(table["first"]);
dikhao(table["last"]);
