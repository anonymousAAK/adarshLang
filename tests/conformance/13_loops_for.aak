# ginnati (C-style for) loops with bas, aage_badho and different update forms

badlo total = 0;
ginnati (badlo i = 1; i <= 10; i += 1) {
    agar (i % 3 == 0) {
        aage_badho;
    }
    total += i;
}
dikhao(total);

badlo evens = [];
ginnati (badlo j = 0; j < 100; j = j + 1) {
    agar (j == 6) {
        bas;
    }
    agar (j % 2 == 1) {
        aage_badho;
    }
    push(evens, j);
}
dikhao(evens);

# counting down
ginnati (badlo k = 5; k > 0; k -= 1) {
    dikhao(k);
}

# loop variable declared outside the loop
badlo idx = 9;
ginnati (idx = 0; idx < 3; idx += 1) {
    dikhao(idx);
}
dikhao(idx);

# loop that never runs
ginnati (badlo z = 5; z < 0; z += 1) {
    dikhao("nahi chalega");
}

# nested body with local variables that do not leak between iterations
badlo sumSq = 0;
ginnati (badlo m = 1; m <= 4; m += 1) {
    badlo sq = m * m;
    sumSq += sq;
}
dikhao(sumSq);
