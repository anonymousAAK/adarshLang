# ke_liye (for-each) over lists, strings, dict keys and ranges, with 'in' and ':' separators

ke_liye (badlo f : ["seb", "kela", "amrud"]) {
    dikhao(f);
}

ke_liye (badlo ch in "abc") {
    dikhao(ch + "-");
}

ke_liye (badlo key in {"x": 1, "y": 2}) {
    dikhao(key);
}

ke_liye (badlo n in range(3)) {
    dikhao(n * 10);
}

# the colon separator without badlo reuses an existing variable
badlo last = 0;
ke_liye (last : [5, 6]) {
    dikhao(last);
}
dikhao(last);

# badlo in the loop creates a new variable that shadows the outer one
badlo item = "outer";
ke_liye (badlo item in [1, 2]) {
    dikhao(item);
}
dikhao(item);

# empty iterable
ke_liye (badlo z in []) {
    dikhao("never");
}

# foreach with break and continue
ke_liye (badlo v in range(1, 10)) {
    agar (v % 2 == 0) {
        aage_badho;
    }
    agar (v > 6) {
        bas;
    }
    dikhao(v);
}

# foreach over a list of lists
ke_liye (badlo pair in [[1, "a"], [2, "b"]]) {
    dikhao(pair[1]);
}
