# map, filter and reduce with anonymous functions, named functions, and builtins passed as values

kaam esBada(x) {
    wapas x > 3;
}

badlo nums = [1, 2, 3, 4, 5, 6];

badlo squares = map(kaam (x) { wapas x * x; }, nums);
dikhao(squares);

badlo evens = filter(kaam (x) { wapas x % 2 == 0; }, nums);
dikhao(evens);

badlo bigOnes = filter(esBada, [1, 5, 2, 8]);
dikhao(bigOnes);

badlo total = reduce(kaam (acc, x) { wapas acc + x; }, nums);
dikhao(total);

badlo product = reduce(kaam (acc, x) { wapas acc * x; }, nums, 1);
dikhao(product);

badlo biggest = reduce(kaam (a, b) { wapas max_val(a, b); }, [3, 9, 4]);
dikhao(biggest);

badlo joined = reduce(kaam (a, b) { wapas a + b; }, ["x", "y", "z"]);
dikhao(joined);

# builtins can be passed where a function is expected
dikhao(map(upper, ["ab", "cd"]));
dikhao(map(length, ["abc", "", "de"]));

# chaining: map then filter then reduce
badlo pipeline = reduce(
    kaam (acc, x) { wapas acc + x; },
    filter(kaam (x) { wapas x > 2; }, map(kaam (x) { wapas x * 3; }, [1, 2, 3])),
    0
);
dikhao(pipeline);

# filter on an empty list and map on a list of strings
dikhao(filter(esBada, []));
dikhao(map(kaam (s) { wapas s + "!"; }, ["hi", "bye"]));

# reduce with a provided initial value on an empty list
dikhao(reduce(kaam (acc, x) { wapas acc + x; }, [], 42));
