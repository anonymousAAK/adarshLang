# Batch B: control flow and errors
kaam bhaag(a, b) {
    pakdo {
        wapas a / b;
    } chhoddo (e) {
        dikhao("pakda: {e}");
        wapas khali;
    } aakhir {
        dikhao("aakhir hamesha chalta hai");
    }
}
dikhao(bhaag(10, 2));
dikhao(bhaag(1, 0));

## smarter chuno
kaam grade(m) {
    chuno (m) {
        case 90..100: wapas "A";
        case 75..89: wapas "B";
        case x agar x < 0: wapas "galat";
        warna_case: wapas "C";
    }
}
dikhao([grade(95), grade(80), grade(-3), grade(50)]);
kaam shape(v) {
    chuno (v) {
        case []: wapas "khali";
        case [akela]: wapas "ek: {akela}";
        case [pehla, ...rest]: wapas "pehla {pehla}, baaki {length(rest)}";
        case number: wapas "number hai";
        warna_case: wapas "kuch aur";
    }
}
dikhao([shape([]), shape([7]), shape([1, 2, 3]), shape(4), shape("x")]);

## typed errors
dhacha Galti2 { sandesh };
dhacha BalanceKam : Galti2 { kami };
kaam nikaalo(balance, rakam) {
    agar (rakam > balance) { chhoddo(BalanceKam { sandesh: "paise kam", kami: rakam - balance }); }
    wapas balance - rakam;
}
pakdo {
    nikaalo(100, 250);
} chhoddo (e: BalanceKam) {
    dikhao("BalanceKam: {e.kami} kam");
} chhoddo (e) {
    dikhao("koi aur");
}
pakdo { badlo z = [1][5]; } chhoddo (e: BalanceKam) { dikhao("nahi"); } chhoddo (e: Galti) { dikhao("runtime pakda"); }

## generators
kaam ginti(n) {
    ginnati (badlo i = 1; i <= n; i += 1) { dete_raho i * 10; }
}
dikhao(ginti(4));
kaam fib(n) { badlo [a, b] = [0, 1]; ke_liye (badlo _i in 1..n) { dete_raho a; badlo t = a + b; a = b; b = t; } }
dikhao(fib(8));

## ruko and band_karo (band_karo is tested at the end)
ruko(0);

# Batch C: data types
badlo s = set([3, 1, 3, 2, 1]);
dikhao(s);
push(s, 5);
dikhao(length(s));
dikhao(2 in s);
dikhao(union(set([1, 2]), set([2, 3])));
dikhao(intersection([1, 2, 3], [2, 3, 4]));
dikhao(difference([1, 2, 3], [2]));

vikalp Rang { Laal, Hara, Neela };
badlo r = Rang.Hara;
dikhao(r);
dikhao(r.naam);
dikhao(r.kram);
dikhao(r == Rang.Hara);
dikhao(r hai Rang);
chuno (r) {
    case Rang.Laal: dikhao("ruko");
    case Rang.Hara: dikhao("chalo");
    warna_case: dikhao("dekho");
}

badlo jagah = (28.6, 77.2);
dikhao(jagah);
dikhao(jagah[0]);
dikhao((1,));
dikhao({jagah: "Delhi"}[(28.6, 77.2)]);

dhacha Vyakti { naam = "anjaan", umar = 0 };
dhacha Student : Vyakti { roll };
kaam Vyakti.parichay() { wapas "Main {yeh.naam}, umar {yeh.umar}"; }
kaam Student.shabd() { wapas "<Student {yeh.naam} #{yeh.roll}>"; }
badlo st = Student { naam: "Riya", roll: 7 };
dikhao(st);
dikhao(st.parichay());
dikhao(Vyakti {});
dikhao([st, 1]);
dikhao("interpolation: {st}");
dikhao(st hai Student);
dikhao(st hai Vyakti);
dikhao(st hai dhacha);
dikhao(5 hai number);
dikhao("5" hai number);

dhacha Paisa { rupaye };
kaam Paisa.jodo(other) { wapas Paisa { rupaye: yeh.rupaye + other.rupaye }; }
kaam Paisa.barabar(other) { wapas yeh.rupaye == other.rupaye; }
kaam Paisa.chhota(other) { wapas yeh.rupaye < other.rupaye; }
kaam Paisa.shabd() { wapas rupaye(yeh.rupaye); }
badlo kul = Paisa { rupaye: 120 } + Paisa { rupaye: 80 };
dikhao(kul);
dikhao(kul == Paisa { rupaye: 200 });
dikhao(Paisa { rupaye: 5 } < Paisa { rupaye: 9 });
dikhao(Paisa { rupaye: 5 } >= Paisa { rupaye: 9 });

badlo umar: number = 24;
umar = 25;
dikhao(umar);
kaam double(x: number) -> number { wapas x * 2; }
dikhao(double(21));
pakdo { umar = "pachchees"; } chhoddo (e) { dikhao(e); }
pakdo { double("do"); } chhoddo (e) { dikhao(e); }

dikhao("band karne se pehle");
band_karo(0);
dikhao("yeh nahi chhapega");
